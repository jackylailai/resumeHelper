# Copy to .env (git-ignored) and fill in real values for local dev.

# --- Data Storage -----------------------------------------------------------
# PostgreSQL data directory (stored OUTSIDE the project for persistence).
# Default: ~/resumeHelper_data
# RESUMEHELPER_DATA_PATH=~/resumeHelper_data

# Where scrape_jobs.py writes its CSV snapshots of job_listings, kept OUTSIDE
# the project so they survive `git clean` and are never accidentally committed.
# Default: ~/resumeHelper_data/backups
# RESUMEHELPER_BACKUP_DIR=~/resumeHelper_data/backups

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resume_helper

# --- LLM provider ----------------------------------------------------------
# LLM_BACKEND=claude_cli (default) uses the `claude` CLI subprocess.
# Two auth paths — pick one, leave the other empty:
#   1. Subscription via Claude Code (recommended): generate a long-lived token
#      on the host with `claude setup-token`, paste it into
#      CLAUDE_CODE_OAUTH_TOKEN. Works for both host and container modes — the
#      container reads this env var instead of the macOS Keychain.
#   2. API key billing: set ANTHROPIC_API_KEY (https://console.anthropic.com/).
# Switch LLM_BACKEND=anthropic to bypass the CLI and call the SDK directly.
LLM_BACKEND=claude_cli
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=

# Pinning the prompt revision lets us tell apart score drifts caused by
# prompt edits versus resume edits (constitution Principle V).
LLM_PROMPT_VERSION=resume-fit-v1
# Step-specific prompt pins. LLM_EVALUATE_PROMPT_VERSION may be left blank to
# use LLM_PROMPT_VERSION for backward compatibility.
LLM_EVALUATE_PROMPT_VERSION=
LLM_TAILOR_PROMPT_VERSION=tailor-v1
LLM_EXTRACT_PROMPT_VERSION=extract-v1
LLM_BEAUTIFY_PROMPT_VERSION=beautify-v1
LLM_MODEL=claude-sonnet-4-6

# --- Resume Generation Threshold ------------------------------------------
# Score threshold to trigger resume tailoring (0-100)
RESUME_GEN_THRESHOLD=60

# --- Storage ---------------------------------------------------------------
# Where uploaded PDFs/DOCX files are persisted. Git-ignored.
STORAGE_DIR=./backend/storage

# --- Limits ----------------------------------------------------------------
MAX_UPLOAD_BYTES=10485760   # 10 MB
MAX_JD_CHARS=5000
# Set false for CI, cron, or e2e jobs that intentionally issue many AI calls.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_EVALUATE_PER_MINUTE=10
RATE_LIMIT_EVALUATE_BULK_PER_MINUTE=2
RATE_LIMIT_EVALUATE_BATCH_PER_MINUTE=10
RATE_LIMIT_SCRAPE_RUN_PER_MINUTE=3
RATE_LIMIT_BEAUTIFY_PER_MINUTE=5
RATE_LIMIT_CALLBACK_PER_MINUTE=10

# Batch AI guardrails. Set AI_PROVIDER_CALLS_ENABLED=false to block real
# provider calls when LLM_BACKEND is not fake.
AI_PROVIDER_CALLS_ENABLED=true
MAX_BULK_EVALUATE_ITEMS=100
MAX_EVALUATE_LISTING_ITEMS=20
MAX_EVALUATE_PENDING_ITEMS=100
MAX_SCRAPE_AFTER_EVALUATE_ITEMS=100
MAX_TAILORING_JOBS_PER_BATCH=20
# 0 disables estimated token/cost blocking.
MAX_BATCH_ESTIMATED_TOKENS=0
MAX_BATCH_ESTIMATED_COST_USD=0
# Approximate pricing used for audit cost estimates and preflight budgets.
LLM_INPUT_COST_PER_MILLION_TOKENS=3.0
LLM_OUTPUT_COST_PER_MILLION_TOKENS=15.0

# --- Server ----------------------------------------------------------------
PORT=8000
LOG_LEVEL=info
