# Copy to .env (git-ignored) and fill in real values for local dev.

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resume_helper

# --- LLM provider (Anthropic Claude) --------------------------------------
# Required. Obtain from https://console.anthropic.com/.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Pinning the prompt revision lets us tell apart score drifts caused by
# prompt edits versus resume edits (constitution Principle V).
LLM_PROMPT_VERSION=resume-fit-v1
LLM_MODEL=claude-sonnet-4-6

# --- Storage ---------------------------------------------------------------
# Where uploaded PDFs/DOCX files are persisted. Git-ignored.
STORAGE_DIR=./backend/storage

# --- Limits ----------------------------------------------------------------
MAX_UPLOAD_BYTES=10485760   # 10 MB

# --- Server ----------------------------------------------------------------
PORT=8000
LOG_LEVEL=info
